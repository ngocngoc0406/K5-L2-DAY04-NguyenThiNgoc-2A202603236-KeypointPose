# Copy values into your shell environment. Never commit actual credentials.
ROBOFLOW_API_KEY=
ROBOFLOW_WORKSPACE=
ROBOFLOW_FACE_PROJECT=
ROBOFLOW_PERSON_PROJECT=

# Optional local model paths. The person model defaults to yolo11n-pose.pt.
PERSON_POSE_MODEL=yolo11n-pose.pt
FACE_DETECTOR_MODEL=models/blaze_face_short_range.tflite
FACE_LANDMARKER_MODEL=models/face_landmarker.task
KEYPOINT_SCHEMA_PATH=../src/keypoint_schema.json
OUTPUT_DIR=outputs
MAX_UPLOAD_BYTES=10485760
